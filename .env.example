# Copy to .env for local runs:  set -a; source .env; set +a   (Windows: set each in PowerShell with $env:NAME="value")

# Vision: "ollama" (local, private) | "google" (Gemini API) | "off"
GEMMA_BACKEND=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Only needed when GEMMA_BACKEND=google (free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMMA_API_MODEL=gemma-4-26b-a4b-it

# TabPFN: token from https://platform.priorlabs.ai/account/api-keys (leave empty to use local `tabpfn` if installed)
TABPFN_TOKEN=
PREDICTOR_BACKEND=auto

# Fallback location when the browser doesn't share GPS
DEFAULT_LAT=19.0760
DEFAULT_LON=72.8777
DEFAULT_PLACE=Mumbai
